{
  "name": "nyc",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "curl -fsSL https://raw.githubusercontent.com/Ahordal/nyc-dashboard/data/pipeline/geocode-cache.json -o pipeline/geocode-cache.json || rm -f pipeline/geocode-cache.json; curl -fsSL https://raw.githubusercontent.com/Ahordal/nyc-dashboard/data/pipeline/counts-snapshot.json -o pipeline/counts-snapshot.json || rm -f pipeline/counts-snapshot.json",
    "build": "node pipeline/fetch-inspection.mjs && npx vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "node --test pipeline/*.test.mjs",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest"
  },
  "dependencies": {
    "@arcgis/core": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "dotenv": "^17.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
